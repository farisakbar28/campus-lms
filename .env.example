# Local development configuration for campus-lms.
# This file contains shape only. Keep the private .env file untracked.
# Security-sensitive values are intentionally blank so configuration fails closed.

# Application
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug
APP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Compose service
POSTGRES_USER=campus
POSTGRES_DB=campus_lms
POSTGRES_PASSWORD=

# API database connection
# Compose uses the postgres service name; host-native runs need a local override.
DATABASE_URL=postgres://<user>:<password>@postgres:5432/campus_lms?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Authentication
JWT_SECRET=
JWT_ACCESS_TTL=15m
# This variable name is retained for compatibility with the auth-session code.
JWT_REFRESH_TTL=168h

# Migration entrypoint and local migration commands
MIGRATE_DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?sslmode=disable
