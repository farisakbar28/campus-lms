# ============================================================
# campus-lms — contoh environment. Salin ke .env lalu isi.
# .env TIDAK PERNAH di-commit (sudah ada di .gitignore).
# Prinsip 12-factor: SEMUA konfigurasi lewat env, tanpa kecuali.
# ============================================================

# ---------- App ----------
APP_ENV=development           # development | production
APP_PORT=8080
APP_LOG_LEVEL=debug           # debug | info | warn | error
APP_SHUTDOWN_TIMEOUT=10s

# ---------- Postgresql Compose (Minggu 4) ----------
POSTGRES_USER=campus
POSTGRES_DB=campus_lms
POSTGRES_PASSWORD=

# ---------- Database (Minggu 3) ----------
# Dev: Postgres lokal di Docker. Prod (Minggu 4): connection string Neon.
DATABASE_URL=postgres://campus:campus@localhost:5432/campus_lms?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- Redis (Minggu 6) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Auth (Minggu 3-4) ----------
JWT_SECRET=ganti-dengan-nilai-acak-panjang
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---------- Object storage (Minggu 8) ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campus-materials

# ---------- AI service (Minggu 7+) ----------
AI_SERVICE_URL=http://localhost:8000
# Semua provider di bawah GRATIS dan TIDAK butuh kartu.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
LLM_MONTHLY_TOKEN_BUDGET=5000000

# ---------- Observability (Minggu 6) ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=campus-api
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
